# NEX — providers + run knobs (.env)
#
# Copy this file to `nex/.env` (or the repo root as `.env`) and fill in what
# you have. Nex reads, in this order:
#     nex/.env  ->  <repo>/.env  ->  ~/.nex/.env
# A variable that is already set in the process environment WINS over .env,
# so a shell export always beats a file.
#
# You can also set the provider part from the settings page
# (/settings.html -> "Models & providers"); it stores keys in
# ~/.nex/providers.json (0600). Keys are never sent back to the browser —
# the API returns them masked.
#
# Everything below is OPTIONAL except one thing: at least one working
# provider. With no key at all, Nex still runs on the local model.

# ===========================================================================
# 1. PROVIDERS
# ===========================================================================

# --- Builder: NVIDIA NIM (build.nvidia.com -> API Keys) --------------------
# Starts with `nvapi-`. The builder is the model that does the WORK, so it is
# the one that runs often: free tier is ~40 requests/minute, per-model limits
# are not published and there is no usage endpoint. Nex therefore counts the
# requests itself (see NEX_NIM_RPM below) and paces them.
NVIDIA_API_KEY=

# Optional: where NIM points and which model the builder uses.
# NEX_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NEX_BUILDER_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Planner: GPT (or any OpenAI-compatible endpoint) ----------------------
# The planner does the reasoning: design document, systems, tests, task graph.
# It is called a handful of times per run — the builder is the busy one — so
# a strong/expensive model is the right choice here.
OPENAI_API_KEY=
# NEX_OPENAI_BASE_URL=https://api.openai.com/v1
# NEX_PLANNER_MODEL=gpt-5.1

# --- Local model (Ollama) — the fallback that always works -----------------
# If NVIDIA (or GPT) is rate-limited, unreachable or not configured at all,
# the local model takes over the SAME plan and keeps building. It is also the
# terminal fallback of every chain: a chain never ends without a provider.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b

# --- Roles: which provider serves which role -------------------------------
# planner: local | gpt | nim      (default: gpt if a key exists, else local)
# builder: nim | gpt | local      (default: nim if a key exists, else local)
# NEX_PLANNER_PROVIDER=local
# NEX_BUILDER_PROVIDER=nim

# --- Explicit failover order (comma separated, names, LOCAL last) ----------
# Unset = the documented default chains: builder -> [nim, local],
# planner -> [gpt, local]. Set these only if you want another order; the
# local provider is always appended as the terminal fallback.
# NEX_BUILDER_FALLBACKS=nim,gpt,local
# NEX_PLANNER_FALLBACKS=gpt,nim,local

# --- Rate budget & pacing (the 40 RPM problem) -----------------------------
# NEX_NIM_RPM=40            # what your key counts as its per-minute budget
# NEX_AUTH_BLOCK_S=900      # how long a provider stays blocked after a 401
#
# Pacing itself is per provider spec (see nex/agent/providers.py):
#   reserve = 0.25   -> Nex aims at 75 % of the budget (40 RPM -> soft cap 30)
#   min_interval_s=1 -> never hammer two calls into the same instant
#   max_chill_s=8    -> bounded wait instead of an unbounded sleep
# The reserve exists so the next minute still has budget for the calls that
# matter — and a 429 cooldown waits until the window actually has room again.

# ===========================================================================
# 2. RUN SHAPE (how much a single run may do)
# ===========================================================================
# NEX_MAX_SYSTEMS=6            # systems the Director may plan per project
# NEX_MAX_SYSTEMS_PER_RUN=2    # systems a single run may finish
# NEX_MAX_STEPS_PER_SYSTEM=4   # build steps per system (playtest steps are
#                              # never cut by this budget)
# NEX_RUN_BUDGET_S=900         # wall-clock budget for one run
# NEX_QUALITY_TARGET=0.6       # 0..1 (the critics score 1-10 internally);
#                              # below it a polish round runs instead of PASS
# NEX_MAX_QUALITY_ROUNDS=1     # how many polish rounds a run may spend
# NEX_BATCH_MAX_CALLS=3        # tool calls batched into one builder call
#                              # (halved automatically on provider trouble)

# ===========================================================================
# 3. MCP BOUNDARY (what the agent may touch)
# ===========================================================================
# The agent acts ONLY through MCP tools. These switches are the operator's
# escape hatches — never the model's.
# NEX_ALLOW_CODE_EXECUTION=<mcp-server-name>   # allow code-exec tools there
# NEX_ALLOW_CONFIRMATIONS=<mcp-server-name>    # allow gated tools there
# NEX_STRICT_SERVERS=1                         # (default) strict server policy
# NEX_TRUSTED_SERVERS=roblox-studio,unreal-engine
# NEX_PROVIDER_HOSTS=integrate.api.nvidia.com,api.openai.com  # SSRF allowlist

# ===========================================================================
# 4. SERVER / UI
# ===========================================================================
# NEX_PORT=8787
# NEX_HOST=0.0.0.0
# NEX_PROVIDERS_FILE=~/.nex/providers.json
# NEX_OBSERVER_COOLDOWN=12     # seconds between file-watch observations
