# NEX — providers (.env)
#
# Copy this file to `nex/.env` (or the repo root as `.env`) and fill in what
# you have. Nex reads, in this order:
#     nex/.env  ->  <repo>/.env  ->  ~/.nex/.env
# A variable that is already set in the process environment WINS over .env,
# so a shell export always beats a file.
#
# You can also set everything from the settings page (/settings.html ->
# "Models & providers"); it stores keys in ~/.nex/providers.json (0600).
# Keys are never sent back to the browser — the API returns them masked.

# --- Builder: NVIDIA NIM (build.nvidia.com -> API Keys) --------------------
# Starts with `nvapi-`. Free tier: ~40 requests/minute, per-model limits are
# not published and there is no usage endpoint, so Nex counts the requests
# itself (NEX_NIM_RPM) and fails over when the budget is spent.
NVIDIA_API_KEY=

# Optional: override where NIM points / which model the builder uses.
# NEX_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NEX_BUILDER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEX_NIM_RPM=40

# --- Planner: GPT (or any OpenAI-compatible endpoint) ----------------------
# The planner does the reasoning: design document, systems, tests. It is
# called a handful of times per run — the builder is the one that runs often.
OPENAI_API_KEY=
# NEX_OPENAI_BASE_URL=https://api.openai.com/v1
# NEX_PLANNER_MODEL=gpt-5.1

# --- Local model (Ollama) — the fallback that always works -----------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b

# --- Roles -----------------------------------------------------------------
# planner: local | gpt | nim      (default: gpt if a key exists, else local)
# builder: nim | gpt | local      (default: nim if a key exists, else local)
# NEX_PLANNER_PROVIDER=local
# NEX_BUILDER_PROVIDER=nim

# --- Escape hatches (see nex/mcp/policy.py) --------------------------------
# Only these allow an autonomous run to touch code-execution tools:
# NEX_ALLOW_CODE_EXECUTION=<mcp-server-name>
# NEX_ALLOW_CONFIRMATIONS=<mcp-server-name>
