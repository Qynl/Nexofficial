# NEX — model providers + agent knobs (.env)
#
# Copy this file to `nex/.env` (or the repo root as `.env`) and fill in
# what you have. Nex reads, in this order:
#     nex/.env  ->  <repo>/.env  ->  ~/.nex/.env
# A variable already set in the process environment WINS over .env, so
# a shell export always beats a file.
#
# You can also configure providers from the app itself
# (Settings → Model); that stores keys in ~/.nex/providers.json (0600).
# Keys are never sent back to the browser — the API returns them masked.
#
# Everything here is OPTIONAL except one thing: at least one working
# provider. With no key at all, Nex runs on the local model.

# ===========================================================================
# 1. PROVIDERS
# ===========================================================================

# Two workload lanes, each with its own provider chain:
#   chat  — ROUTINE: conversation, summaries, small plans (Ollama first)
#   agent — HARD: complex plans, evaluation, diagnosis (NIM/GPT first)
# Hard-work default: NIM -> configured GPT -> free OpenCode Zen -> free
# OpenRouter -> Ollama. Any provider without a key for that lane is skipped
# cleanly. The validated MCP plan never changes — only the model serving it.

# --- Local model (Ollama) — always present, needs no key -------------------
#OLLAMA_HOST=http://127.0.0.1:11434
#OLLAMA_MODEL=gpt-oss:20b

# --- Routine lane (chat / summary / small plan) -----------------------------
#NEX_CHAT_PROVIDER=local                      # local | nim | gpt | opencode | openrouter
#NEX_CHAT_MODEL=gpt-oss:20b
#NEX_CHAT_FALLBACKS=opencode,openrouter,gpt,nim   # free clouds before paid ones

# --- Hard-work lane (complex plan / evaluate / diagnose) --------------------
# Prefers NIM; missing keys are skipped, so GPT serves next, then the free
# gateways, then local.
#NEX_AGENT_PROVIDER=nim
#NEX_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
#NEX_AGENT_FALLBACKS=gpt,opencode,openrouter,local

# --- NVIDIA NIM (build.nvidia.com → API Keys, starts with nvapi-) ----------
# Hosted limits vary by account/model/load. NEX_NIM_RPM is Nex's local safety
# ceiling, not a claim about NVIDIA's quota. Settings → Model also controls
# structured JSON output for machine-consumed agent jobs.
#NVIDIA_API_KEY=
#NEX_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
#NEX_NIM_RPM=40
#NEX_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Any OpenAI-compatible endpoint (OpenAI, LM Studio, vLLM, ...) ---------
#OPENAI_API_KEY=
#NEX_OPENAI_MODEL=gpt-5.1
#NEX_OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenCode Zen — FREE, no card (opencode.ai/auth → API Keys) -------------
# Several models are $0/token today: Ling 3.1 Flash (default — the same
# strong free agentic model OpenRouter below also defaults to, now free
# directly on Zen too), Nemotron 3 Ultra/Lightning, Ling 3.0 Flash Fin,
# MiMo-V2.6 Flash, Big Pickle. A free listing can change or be retired —
# Settings → Model always reads the live catalog from opencode.ai/zen/v1/models.
#OPENCODE_API_KEY=
#NEX_OPENCODE_MODEL=ling-3.1-flash-free
#NEX_OPENCODE_RPM=20
#NEX_OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- OpenRouter — FREE, no card (openrouter.ai/keys) ------------------------
# 20+ ":free" models behind one key. Default here is Ling 3.1 Flash
# (inclusionAI, 560B-MoE/25B-active, 262K context) — a strong free agentic
# model. Free tier is ~20 req/min and 50/day (1,000/day after a $10 top-up).
#OPENROUTER_API_KEY=
#NEX_OPENROUTER_MODEL=inclusionai/ling-3.1-flash
#NEX_OPENROUTER_RPM=20
#NEX_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Provider hygiene -------------------------------------------------------
# Park a provider whose key was rejected, for this many seconds.
#NEX_AUTH_BLOCK_S=900
# Optional strict allowlist of endpoints (comma list); empty = the
# built-in hosts only.
#NEX_PROVIDER_HOSTS=

# ===========================================================================
# 2. MCP SERVERS (Nex's capabilities)
# ===========================================================================

# Nex has NO built-in tools. Everything it can do comes from MCP
# servers you connect — in the UI (Capabilities → Add server) or here.
#
# Format: name=URL (http) or name:command arg1 arg2 (stdio), comma list.
#   NEX_SERVERS=blender=http://127.0.0.1:9876/mcp,weather:uvx mcp-weather
#NEX_SERVERS=

# Loopback endpoints are always allowed; a remote (non-127.0.0.1) URL
# must be confirmed explicitly in the UI. This allowlist pre-approves
# remote hosts (comma list) if you'd rather not click:
#NEX_HTTP_ALLOW=

# Pin the allowed stdio commands (comma list). When set, nothing else
# can be spawned — lockdown for unattended deployments.
#NEX_STDIO_ALLOW=

# Stdio children receive a minimal environment and DO NOT inherit provider
# keys or Nex's auth token. Explicitly list any additional variable names a
# chosen MCP server needs (the Nex auth token can never be delegated).
#NEX_STDIO_ENV_ALLOW=GITHUB_TOKEN

# Servers allowed to serve AUTONOMOUS runs without per-tool approval
# prompts (comma list). Everything else still asks.
#NEX_TRUSTED_SERVERS=

# Standing operator approvals (comma list of server names):
#   NEX_ALLOW_CODE_EXECUTION  — servers whose code-execution tools may run
#                               (never covers an escape payload)
#   NEX_ALLOW_CONFIRMATIONS   — servers whose destructive/network/unknown
#                               tools may run unattended
#NEX_ALLOW_CODE_EXECUTION=
#NEX_ALLOW_CONFIRMATIONS=

# Optional file that pins tool classifications where the heuristics are
# not enough (~/.nex/capabilities.json). Pins can ESCALATE severity,
# never downgrade.
#NEX_CAPABILITY_FILE=

# ===========================================================================
# 3. THE AGENT LOOP
# ===========================================================================

#NEX_MAX_STEPS=64                # tool-call budget (supports staged game builds)
#NEX_MAX_REPLANS=3               # structural replans per run
#NEX_MAX_QUALITY_PASSES=1        # bounded evidence/polish passes for game work
#NEX_MAX_PRODUCTION_STAGES=8     # milestone plans for studio-scale game goals
#NEX_EVAL_EVERY_STEPS=6          # normal progress checks; failures are immediate
#NEX_RUN_BUDGET_S=1800           # wall-clock budget per run
#NEX_APPROVAL_TIMEOUT_S=600      # how long a run waits for your approval
#NEX_BATCH_MAX_CALLS=3           # hard cap for one batched diagnosis

# ===========================================================================
# 4. THE SERVER
# ===========================================================================

#NEX_HOST=0.0.0.0
#NEX_PORT=8787
# Where state lives (conversations, servers.json, token). Default: ~/.nex
#NEX_HOME=
# Use a fixed auth token (minimum 32 characters) instead of the generated one.
#NEX_AUTH_TOKEN=
# Set when Nex is served to the browser over HTTPS (for example by a proxy).
#NEX_COOKIE_SECURE=true
