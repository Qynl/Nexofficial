+        try:
+            chunk = stdin.read(4096)
+        except (OSError, ValueError):
+            break
+        if not chunk:
+            _log("EOF on stdin — shutting down (stopping test client)")
+            with mcp._lock:
+                if mcp._client is not None:
+                    mcp.stop_client_locked()
+            break
